{
    "name": "unwahas/error-managements",
    "description": "Error logging and protected error-log API for Laravel applications",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "unwahas",
        "error-managements",
        "error logging"
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/liar88828/unwahas-error-managements.git"
        }
    ],
    "autoload": {
        "psr-4": {
            "Unwahas\\ErrorRedirect\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.1",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0"
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Unwahas\\ErrorRedirect\\ErrorRedirectServiceProvider"
            ]
        }
    },
    "authors": [
        {
            "name": "Brian",
            "email": "liar88828@gmail.com"
        }
    ],
    "minimum-stability": "stable"
}
